{
  "name": "vnilink-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:upstream",
    "typecheck:upstream": "tsc -p src/tsconfig.json --noEmit",
    "build": "npm run typecheck && node build/build.mjs",
    "package:dir": "npm run build:release && node scripts/package-app.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:release": "npm run check:product && npm run typecheck && node scripts/build-release.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && npm run test:native && node scripts/test.mjs",
    "format": "node build/format.mjs --write",
    "format:check": "node build/format.mjs --check",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "check:product": "node build/product.mjs",
    "check:upstream": "node build/check-vscode-source.mjs",
    "check": "npm run check:product && npm run check:upstream && npm run format:check && npm run lint && npm run typecheck && npm run test:tooling",
    "test:linux": "node scripts/test-linux.mjs",
    "test:ui": "node scripts/test.mjs",
    "test:native": "node --test test/native/*.test.mjs",
    "prepare": "husky",
    "precommit": "npm run check && cargo fmt --all -- --check && npm test",
    "watch": "node scripts/dev.mjs --watch-only",
    "test:rust": "node scripts/test-rust.mjs",
    "package:installers": "npm run package:dir && node scripts/package-installers.mjs",
    "package:installers:staged": "node scripts/package-installers.mjs",
    "verify:installers": "node scripts/verify-installers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@types/trusted-types": "2.0.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "type": "module"
}
