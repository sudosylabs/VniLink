{
  "name": "vnilink-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "npm start",
    "test": "npm run build && npm run test:native && electron out/smoke.cjs",
    "format": "node build/format.mjs --write",
    "format:check": "node build/format.mjs --check",
    "lint:ts": "eslint \"src/**/*.ts\" \"build/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.{ts,mjs}\" \"*.config.mjs\" --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "eslint \"src/**/*.ts\" \"build/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.{ts,mjs}\" \"*.config.mjs\" --fix && stylelint \"src/**/*.css\" --fix",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:tooling",
    "test:native": "node --test test/native/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "type": "module"
}
