root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{ts,mts,cts,js,mjs,cjs,css,html}]
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4
